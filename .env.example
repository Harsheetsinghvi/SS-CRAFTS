# VanaKriti MDF Studio - Environment Configuration Example

# Node Environment
NODE_ENV=production

# Server Port (Default: 3000)
PORT=3000

# Admin JWT Authentication Secret (Generate a strong 32+ character random string in production)
ADMIN_JWT_SECRET=vanakriti_mdf_super_secret_jwt_key_2025_secure

# Default Admin Credentials for initial setup (Hashed in data/db.json)
# Default Email: admin@vanakritimdf.com
# Default Password: Admin@MDF2025

# Business WhatsApp Configuration (Without '+' or spaces, with country code. e.g., 919876543210)
NEXT_PUBLIC_DEFAULT_WHATSAPP=919876543210
